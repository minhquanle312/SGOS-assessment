# Custom OpenAI-compatible endpoint (CommandCode)
AI_API_BASE_URL=https://api.commandcode.ai/provider/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Postgres (matches docker-compose.yml defaults)
POSTGRES_USER=sgos
POSTGRES_PASSWORD=sgos_dev_password
POSTGRES_DB=sgos_assessment

# Use "localhost" when running `npm run dev` / `prisma migrate` on the host
# against the docker-compose Postgres (port-mapped to localhost:5432).
# Inside docker-compose, the app service overrides this to use host "db".
DATABASE_URL=postgresql://sgos:sgos_dev_password@localhost:5432/sgos_assessment?schema=public
